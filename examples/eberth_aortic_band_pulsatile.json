{
  "description": {
    "model": "Eberth et al. (2009) transverse aortic-arch banding, mouse carotids",
    "reference": "Eberth et al., J. Hypertens. 27:2010-2021 (2009); see main.pdf 'Modeling strategy', Fig. 1 and Eq. (6)",
    "topology": "heart(Qin)->aortic valve->ascending aorta(Ra,La,Ca)->node A ->[RCCA-B / right head RCR] and ->band(dP_band(Q)) ->node B ->[LCCA-B / left head RCR] and ->descending aorta(Ro,Lo)->systemic RCR",
    "key_test": "With the band as the ONLY inter-carotid difference, node A (RCCA-B, upstream) stays pulsatile while node B (LCCA-B, downstream) is damped by the resistive-inertial band.",
    "units": "pressure [mmHg], flow [ml/s], time [s]",
    "validation_targets_Table1": {
      "PI_RCCA_B": 3.11,
      "PI_LCCA_B": 1.65,
